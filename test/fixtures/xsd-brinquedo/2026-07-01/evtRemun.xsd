<?xml version="1.0" encoding="UTF-8"?>
<!-- XSD DE BRINQUEDO, não é o oficial. Só imita a forma esperada do pacote
     (D-07): um .xsd por evento, tipos compartilhados por include e a
     assinatura digital por import do xmldsig. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.esocial.gov.br/schema/evt/evtRemun/v_S_01_03_00"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           targetNamespace="http://www.esocial.gov.br/schema/evt/evtRemun/v_S_01_03_00"
           elementFormDefault="qualified">
  <xs:include schemaLocation="tipos.xsd"/>
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:element name="eSocial">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="evtRemun">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ideTrabalhador">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="cpfTrab" type="TS_cpf"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="itensRemun" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="dscRubr" type="xs:string" minOccurs="0"/>
                    <xs:element name="vrRubr" type="TS_valor"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="Id" type="xs:ID" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="ds:Signature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
