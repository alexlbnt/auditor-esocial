{
  "name": "pente-fino",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/gerar-xsd-web.ts",
    "dev": "next dev",
    "prebuild": "node scripts/gerar-xsd-web.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit-cli.ts",
    "audit:local": "node scripts/audit-cli.ts local-data --segredo-arquivo local-data/.segredo --saida local-data/.resultado --comparar local-data/.linha-de-base",
    "demo": "node scripts/gerar-demo.ts",
    "checar-dados": "node scripts/checar-dados-reais.ts"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "libxml2-wasm": "0.7.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
